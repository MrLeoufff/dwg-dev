{% extends 'base.html.twig' %}

{% block title %}Tableau de bord - Administration
{% endblock %}

{% block body %}
	<section class="section">
		<div class="container">
			<div class="page-header">
				<div>
					<p class="eyebrow">Administration</p>
					<h1>Tableau de bord</h1>
					<p class="section-lead">Pilotez vos contenus et suivez l'activité du site.</p>
				</div>
				<span class="badge-soft">Bienvenue,
					{{ app.user.pseudo }}</span>
			</div>

			<div class="row g-4">
				<div class="col-lg-4">
					<div class="dashboard-card">
						<div class="dashboard-card__icon">
							<i class="bi bi-box-seam"></i>
						</div>
						<h3>Produits & offres</h3>
						<p>Ajoutez, éditez et organisez vos offres.</p>
						<a href="{{ path('app_product_index') }}" class="btn btn-primary">Accéder</a>
					</div>
				</div>
				<div class="col-lg-4">
					<div class="dashboard-card">
						<div class="dashboard-card__icon">
							<i class="bi bi-people"></i>
						</div>
						<h3>Utilisateurs</h3>
						<p>Gérez les comptes clients et leurs accès.</p>
						<a href="{{ path('admin_user') }}" class="btn btn-outline-primary">Accéder</a>
					</div>
				</div>
				<div class="col-lg-4">
					<div class="dashboard-card">
						<div class="dashboard-card__icon">
							<i class="bi bi-graph-up-arrow"></i>
						</div>
						<h3>Statistiques</h3>
						<p>Suivez les performances et les demandes.</p>
						<a href="#" class="btn btn-outline-primary">Voir les détails</a>
					</div>
				</div>
			</div>
		</div>
	</section>
{% endblock %}
