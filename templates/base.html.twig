<!DOCTYPE html>
<html lang="fr">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<title>
			{% block title %}DWG
			{% endblock %}
		</title>

		{# Styles #}
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Sora:wght@600;700&display=swap" rel="stylesheet">
		<link rel="icon" type="image/jpeg" href="{{ asset('images/474851447_122125318802592487_4148178225004169393_n.jpg') }}">
		<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/css/bootstrap.min.css" rel="stylesheet">
		<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
		<link rel="stylesheet" href="{{ asset('styles/spider.css') }}?v=2">
		<link rel="stylesheet" href="{{ asset('styles/style.css') }}?v=2">
	</head>
	<body>
		<header>
			<nav class="navbar navbar-expand-lg navbar-dark">
				<div class="container">
					<a class="navbar-brand" href="{{ path('app_home') }}">
						<img class="brand-logo-image" src="{{ asset('images/474851447_122125318802592487_4148178225004169393_n.jpg') }}" alt="Logo DWG">
						<span class="brand-name">DWG</span>
					</a>
					<button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
						<span class="navbar-toggler-icon"></span>
					</button>
					<div class="collapse navbar-collapse" id="navbarNav">
						<ul class="navbar-nav ms-auto">
							{% if is_granted('IS_AUTHENTICATED_FULLY') %}
								{% if is_granted('ROLE_ADMIN') %}
									<!-- Liens pour l'admin -->
									<li class="nav-item">
										<a class="nav-link" href="{{ path('admin_dashboard') }}">
											<i class="bi bi-speedometer2"></i>
											Tableau de bord
										</a>
									</li>
									<li class="nav-item">
										<a class="nav-link" href="{{ path('app_product_index') }}">
											<i class="bi bi-box-seam"></i>
											Gestion des produits
										</a>
									</li>
								{% endif %}
								<li class="nav-item">
									<a class="nav-link" href="{{ path('app_logout') }}">
										<i class="bi bi-box-arrow-right"></i>
										Déconnexion
									</a>
								</li>
							{% else %}
								<li class="nav-item">
									<a class="nav-link" href="{{ path('app_login') }}">
										<i class="bi bi-box-arrow-in-right"></i>
										Connexion
									</a>
								</li>
								<li class="nav-item">
									<a class="nav-link" href="{{ path('app_register') }}">
										<i class="bi bi-person-plus"></i>
										Inscription
									</a>
								</li>
							{% endif %}
						</ul>
					</div>
				</div>
			</nav>
			<div class="spider-container"></div>
			<div class="theme-toggle-container">
				<button id="theme-toggle" aria-label="Changer le mode">
					<i class="bi bi-moon"></i>
				</button>
			</div>
			<div class="hero">
				<div class="container hero-content">
					<p class="hero-eyebrow">Agence web & formation</p>
					<h1 class="hero-title">Des expériences numériques claires, rapides et élégantes.</h1>
					<p class="hero-subtitle">Sites vitrines, e-commerce et formations sur-mesure pour développer votre activité.</p>
					<p class="hero-signature">Une méthode simple : écouter, designer, livrer.</p>
					<div class="hero-actions">
						<a href="#services" class="btn btn-primary btn-lg">Découvrir nos services</a>
						<a href="#presentation" class="btn btn-outline-light btn-lg">Qui sommes-nous</a>
					</div>
				</div>
			</div>
		</header>
		{% for label, messages in app.flashes %}
			<div class="alert alert-{{ label }}">
				{% for message in messages %}
					{{ message }}
				{% endfor %}
			</div>
		{% endfor %}


		{# Main Content Block #}
		<main class="main-content">
			{% block body %}
				<div class="container">
					{% for type, messages in app.flashes %}
						{% for message in messages %}
							<div class="alert alert-{{ type }} mt-2">
								{{ message }}
							</div>
						{% endfor %}
					{% endfor %}
				{% endblock %}
			</main>
			<footer class="site-footer">
				<div class="container footer-content">
					<div class="footer-brand">
						<p class="footer-logo">
							<img class="footer-logo-image" src="{{ asset('images/474851447_122125318802592487_4148178225004169393_n.jpg') }}" alt="Logo DWG">
							DWG
						</p>
						<p class="footer-tagline">Studio web orienté résultat & relation humaine.</p>
					</div>
					<div class="social-links">
						<a href="{{ path('app_mentions_legales') }}">Mentions légales</a>
						<a href="{{ path('app_politique_confidentialite') }}">Politique de confidentialité</a>
						<a href="{{ path('app_cgu') }}">CGU</a>
						<a href="https://www.facebook.com/profile.php?id=61567774622871" target="_blank" rel="noopener">Facebook</a>
						<a href="https://www.facebook.com/profile.php?id=61567774622871" target="_blank" rel="noopener">Facebook Pro</a>
						<a href="https://www.instagram.com/leliardrene/" target="_blank" rel="noopener">Instagram</a>
					</div>
					<div class="contact-info">
						<p>
							Email :
							<a href="mailto:developpeur.web.gard@gmail.com">developpeur.web.gard@gmail.com</a>
						</p>
					</div>
				</div>
			</footer>
		</div>
		{# Scripts #}
		<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
		<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/ScrollTrigger.min.js"></script>
		<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/js/bootstrap.bundle.min.js"></script>
		<script src="{{ asset('script/script.js') }}?v=2"></script>
		<script src="{{ asset('script/spider.js') }}?v=2"></script>
	</body>
</html>
