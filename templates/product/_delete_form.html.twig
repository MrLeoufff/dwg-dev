<form method="post" action="{{ path('app_product_delete', {'id': product.id}) }}" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this item?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ product.id) }}">
    <button class="btn btn-outline-danger btn-sm">Supprimer</button>
</form>
