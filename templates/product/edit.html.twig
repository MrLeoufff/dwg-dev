{% extends 'base.html.twig' %}

{% block title %}Edit Product
{% endblock %}

{% block body %}
	<section class="section">
		<div class="container">
			<div class="page-header">
				<div>
					<p class="eyebrow">Administration</p>
					<h1>Modifier un produit</h1>
					<p class="section-lead">Mettez à jour les informations et les sessions.</p>
				</div>
				<a href="{{ path('app_product_index') }}" class="btn btn-outline-primary">Retour</a>
			</div>

			<div class="form-card">
				{{ include('product/_form.html.twig', {'button_label': 'Mettre à jour'}) }}
			</div>

			<div class="form-actions">
				{{ include('product/_delete_form.html.twig') }}
			</div>
		</div>
	</section>
{% endblock %}
