{% extends "base.html.twig" %}


{% block body %}
	<section class="section">
		<div class="container">
			<div class="page-header">
				<div>
					<p class="eyebrow">Administration</p>
					<h1>Créer une offre</h1>
					<p class="section-lead">Renseignez les informations clés et les options disponibles.</p>
				</div>
				<a href="{{ path('app_product_index') }}" class="btn btn-outline-primary">Retour</a>
			</div>

			<div class="form-card">
				{{ form_start(form, { 'attr': { 'class': 'form-stack' } }) }}
				{{ form_row(form.name) }}
				{{ form_row(form.description) }}
				{{ form_row(form.price) }}
				{{ form_row(form.type) }}
				{{ form_row(form.startDate) }}

				<div class="form-section">
					<h2>Échéances</h2>
					<p class="section-lead">Ajoutez les dates clés et jalons.</p>
					<div id="sessions" class="session-list" data-prototype="{{ form_widget(form.sessions.vars.prototype)|e('html_attr') }}">
						{{ form_widget(form.sessions) }}
					</div>
				</div>

				<button type="submit" class="btn btn-primary">Créer</button>
				{{ form_end(form) }}
			</div>
		</div>
	</section>

	<script>
		document.addEventListener('DOMContentLoaded', () => {
const collectionHolder = document.querySelector('#sessions');
const addButton = document.createElement('button');
addButton.textContent = 'Ajouter une session';
addButton.classList.add('btn', 'btn-outline-primary', 'mt-2');
collectionHolder.after(addButton);

let index = collectionHolder.querySelectorAll('.session-item').length;

addButton.addEventListener('click', (e) => {
e.preventDefault();
const prototype = collectionHolder.dataset.prototype;

if (! prototype) {
console.error('Prototype manquant !');
return;
}

let newForm = prototype.replace(/__name__/g, index);
collectionHolder.insertAdjacentHTML('beforeend', newForm);
index++;
});
});
	</script>
{% endblock %}
