{% extends 'base.html.twig' %}

{% block title %}Détails du produit
{% endblock %}

{% block body %}
	<section class="section">
		<div class="container">
			<div class="page-header">
				<div>
					<p class="eyebrow">Administration</p>
					<h1>Détails du produit</h1>
					<p class="section-lead">Vue globale des informations et échéances.</p>
				</div>
				<div class="page-actions">
					<a href="{{ path('app_product_index') }}" class="btn btn-outline-primary">Retour</a>
					<a href="{{ path('app_product_edit', {'id': product.id}) }}" class="btn btn-primary">Modifier</a>
				</div>
			</div>

			<div class="table-card">
				<table class="table align-middle">
					<tbody>
						<tr>
							<th>Id</th>
							<td>{{ product.id }}</td>
						</tr>
						<tr>
							<th>Nom</th>
							<td>{{ product.name }}</td>
						</tr>
						<tr>
							<th>Description</th>
							<td>{{ product.description }}</td>
						</tr>
						<tr>
							<th>Prix</th>
							<td>{{ product.price }} €</td>
						</tr>
						<tr>
							<th>Date de création</th>
							<td>{{ product.createdAt ? product.createdAt|date('d/m/Y H:i') : '' }}</td>
						</tr>
						<tr>
							<th>Type</th>
							<td>{{ product.type }}</td>
						</tr>
					</tbody>
				</table>
			</div>

			<div class="table-card">
				<h2>Échéances</h2>
				{% if product.sessions is not empty %}
					<table class="table align-middle">
						<thead>
							<tr>
								<th>#</th>
								<th>Jour</th>
								<th>Heure de début</th>
								<th>Durée (minutes)</th>
							</tr>
						</thead>
						<tbody>
							{% for session in product.sessions %}
								<tr>
									<td>{{ loop.index }}</td>
									<td>{{ session['day']['date']|date('d/m/Y') }}</td>
									<td>{{ session['startTime']['date']|date('H:i') }}</td>
									<td>{{ session['duration'] }} minutes</td>
								</tr>
							{% else %}
								<tr>
									<td colspan="4">Aucune échéance disponible</td>
								</tr>
							{% endfor %}
						</tbody>
					</table>
				{% else %}
					<p class="text-muted">Aucune échéance n'a été planifiée pour ce produit.</p>
				{% endif %}
			</div>

			<div class="form-actions">
				{{ include('product/_delete_form.html.twig') }}
			</div>
		</div>
	</section>
{% endblock %}
